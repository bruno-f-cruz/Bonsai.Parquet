<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net8.0;net8.0-windows</TargetFrameworks>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\Arrow.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Bonsai.Scripting.Expressions" Version="2.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.0.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.0.2" />
    <ProjectReference Include="..\Bonsai.Apache.Arrow\Bonsai.Apache.Arrow.csproj" />
    <ProjectReference Include="..\Bonsai.Apache.Parquet\Bonsai.Apache.Parquet.csproj" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Workflows\api-tests.bonsai" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

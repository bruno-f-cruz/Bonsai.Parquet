<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Bonsai - Apache Parquet Design</Title>
    <Description>Design-time editors for Bonsai.Apache.Parquet.</Description>
    <TargetFrameworks>net472</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Design\SchemaEditor.cs" Link="Common\SchemaEditor.cs" />
    <PackageReference Include="Bonsai.ImGui.Design" Version="0.2.0" />
    <PackageReference Include="Bonsai.Design" Version="2.9.1" />
    <PackageReference Include="ParquetSharp" Version="23.0.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bonsai.Apache.Parquet\Bonsai.Apache.Parquet.csproj" />
  </ItemGroup>

</Project>
